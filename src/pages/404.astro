---
import Base from '../layouts/Base.astro';
import { person } from '../site';
---

<Base title={`Page not found | ${person.name}`} description="This page doesn't exist on Cedar Rose Leach's website.">
  <section class="wrap missing dots">
    <h1>This page doesn't exist</h1>
    <p>The link may be from an older version of the site. Everything is listed on the <a href="/">home page</a>.</p>
  </section>
</Base>

<style>
  .missing {
    padding-block: 6rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    margin: 0 0 1rem;
    color: var(--maroon);
  }
</style>
