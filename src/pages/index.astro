---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkRow from '../components/WorkRow.astro';
import profile from '../assets/profile.png';
import { person, SITE_URL } from '../site';
import { getWork, personJsonLd, workUrl, absolute } from '../lib/work';

const work = await getWork();

const jsonLd = [
  personJsonLd(),
  {
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/#page`,
    url: SITE_URL,
    name: person.name,
    mainEntity: { '@id': `${SITE_URL}/#person` },
  },
  {
    '@type': 'ItemList',
    name: `Work by ${person.name}`,
    itemListElement: work.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: w.data.title,
      url: absolute(workUrl(w)),
    })),
  },
];
---

<Base
  title={`${person.name}, Electrical and Computer Engineering at USC`}
  description={person.description}
  jsonLd={jsonLd}
  ogType="profile"
>
  <header class="hero">
    <div class="wrap hero-grid">
      <div class="intro">
        <h1>{person.name}</h1>
        <p class="line">Electrical and Computer Engineering at USC, class of {person.classOf}.</p>
        <p class="line muted">{person.bio}</p>
        <ul class="contact" aria-label="Contact">
          <li><a href={`mailto:${person.email}`}>Email</a></li>
          <li><a href={person.linkedin}>LinkedIn</a></li>
          <li><a href={person.resume}>Resume</a></li>
        </ul>
      </div>
      <div class="portrait">
        <Picture
          src={profile}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[420, 640, 900, 1200]}
          sizes="(max-width: 52rem) 90vw, 40vw"
          alt="Collage of Cedar smiling in front of red sandstone rocks, framed by a patterned silicon wafer, a person in a cleanroom suit under yellow lithography light, and tweezers holding a wafer."
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </header>

  <section class="wrap work" aria-labelledby="work-title">
    <h2 id="work-title">Work</h2>
    <ul class="list">
      {work.map((w) => <WorkRow work={w} />)}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.9rem, 6.2vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 380;
  }
  .line {
    margin: 0 0 0.35rem;
    max-width: 31rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }
  .muted {
    color: var(--muted);
  }
  .contact {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .contact a {
    text-decoration-color: currentColor;
  }
  .portrait :global(img) {
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-left: auto;
  }

  .work {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .work h2 {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    letter-spacing: 0;
    color: var(--muted);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
    }
    .portrait :global(img) {
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>
