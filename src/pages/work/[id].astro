---
import Carousel from '../../components/Carousel.astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { person, SITE_URL } from '../../site';
import { getWork, formatRange, workUrl, absolute, personJsonLd, type Work } from '../../lib/work';

export async function getStaticPaths() {
  const all = await getWork();
  return all.map((work, i) => ({
    params: { id: work.id },
    props: { work, newer: all[i - 1], older: all[i + 1] },
  }));
}

interface Props {
  work: Work;
  newer?: Work;
  older?: Work;
}

const { work, newer, older } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const url = absolute(workUrl(work));

const jsonLd: object[] = [
  personJsonLd(),
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: d.title,
    description: d.summary,
    url,
    author: { '@id': `${SITE_URL}/#person` },
    keywords: d.tags.join(', '),
    dateCreated: d.start,
    sourceOrganization: { '@type': 'Organization', name: d.org, ...(d.orgUrl ? { url: d.orgUrl } : {}) },
    ...(d.awards.length ? { award: d.awards } : {}),
  },
  ...d.publications.map((p) => ({
    '@type': p.kind === 'Journal article' ? 'ScholarlyArticle' : 'CreativeWork',
    name: p.title,
    headline: p.title,
    author: p.authors,
    datePublished: p.date,
    ...(p.kind === 'Journal article' ? { isPartOf: { '@type': 'Periodical', name: p.venue } } : { publisher: p.venue }),
    ...(p.url ? { url: absolute(p.url) } : {}),
  })),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: person.name, item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---

<Base
  title={`${d.title} | ${person.name}`}
  description={d.summary}
  jsonLd={jsonLd}
  markdown={`/work/${work.id}.md`}
  ogType="article"
  page="work"
>
  <header slot="header" class="bar">
    <nav class="wrap bar-inner" aria-label="Site">
      <a class="home" href="/">Cedar Rose Leach</a>
      <ul class="meta">
        <li><a href="/#work-title">All work</a></li>
        <li><a href={`mailto:${person.email}`}>Email</a></li>
      </ul>
    </nav>
  </header>

  <article class="wrap project">
    <header class="project-head">
      <p class="meta when"><time datetime={d.start}>{formatRange(d.start, d.end)}</time></p>
      <h1>{d.title}</h1>
      <p class="who">
        <span>{d.role}</span>
        <span>{d.orgUrl ? <a href={d.orgUrl}>{d.org}</a> : d.org}</span>
      </p>
    </header>

    {
      (d.supervisor || d.funding.length > 0 || d.awards.length > 0 || d.links.length > 0) && (
        <dl class="facts">
          {d.supervisor && (
            <div>
              <dt>Supervisor</dt>
              <dd>{d.supervisor}</dd>
            </div>
          )}
          {d.funding.length > 0 && (
            <div>
              <dt>Funding</dt>
              <dd>
                <ul>
                  {d.funding.map((f) => (
                    <li>{f.url ? <a href={f.url}>{f.name}</a> : f.name}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {d.awards.length > 0 && (
            <div>
              <dt>Recognition</dt>
              <dd>
                <ul>
                  {d.awards.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {d.links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd>
                <ul>
                  {d.links.map((l) => (
                    <li>
                      <a href={l.url}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      )
    }

    {
      d.publications.length > 0 && (
        <section class="pubs" aria-labelledby="pubs-title">
          <h2 id="pubs-title">Publications</h2>
          <ul>
            {d.publications.map((p) => (
              <li>
                <p class="meta">{p.kind}</p>
                <p>
                  {p.authors} <cite>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</cite>. {p.venue}, {p.date}.
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      d.gallery.length > 0 && (
        <section class="gallery" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Photos and figures</h2>
          <div class="breakout">
            <Carousel items={d.gallery} label={`Photos and figures for ${d.title}`} />
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="More work">
      {
        newer ? (
          <a href={workUrl(newer)} rel="prev">
            <span class="meta">Previous</span>
            <span class="t">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        older && (
          <a href={workUrl(older)} rel="next" class="older">
            <span class="meta">Next</span>
            <span class="t">{older.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }
  .home {
    font-size: 1.1rem;
    text-decoration: none;
  }
  .bar ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .bar ul a {
    text-decoration: none;
  }

  .project {
    max-width: 52rem;
  }
  .project-head {
    padding-top: clamp(2.5rem, 8vw, 5rem);
  }
  .when {
    margin: 0 0 0.9rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 380;
  }
  .who {
    margin: 0.9rem 0 0;
    color: var(--muted);
  }
  .who span {
    display: block;
  }
  .who a {
    color: inherit;
  }

  .facts {
    margin: 2.25rem 0 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--rule);
    display: grid;
    gap: 0.85rem;
  }
  .facts > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0 1.25rem;
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
  .facts dd {
    margin: 0;
  }
  .facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li + li {
    margin-top: 0.3rem;
  }

  .prose {
    margin-top: 2.5rem;
  }
  .prose :global(h2) {
    margin: 2.75rem 0 0.75rem;
    font-size: 1.6rem;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.35rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 1.1rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(blockquote) {
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
    color: var(--muted);
  }

  .pubs {
    margin-top: 2.5rem;
  }
  .gallery {
    margin-top: 3.5rem;
  }
  .pubs h2,
  .gallery h2 {
    font-size: 1.6rem;
    margin: 0 0 1.25rem;
  }
  .pubs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .pubs p {
    margin: 0;
  }

  /* The carousel is wider than the text column, centered on it. */
  .breakout {
    position: relative;
    left: 50%;
    width: min(100vw, 64rem);
    transform: translateX(-50%);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .pager a {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 48%;
  }
  .pager .older {
    text-align: right;
    margin-left: auto;
  }
  .pager .t {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  @media (max-width: 46rem) {
    .facts > div {
      grid-template-columns: 1fr;
    }
  }
</style>
