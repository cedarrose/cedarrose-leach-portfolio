---
import { formatRange, workUrl, type Work } from '../lib/work';

interface Props {
  work: Work;
}
const { work } = Astro.props;
const d = work.data;
---

<article class="row">
  <p class="when meta">
    <time datetime={d.start}>{formatRange(d.start, d.end)}</time>
  </p>
  <div class="what">
    <h3><a href={workUrl(work)}>{d.title}</a></h3>
    <p class="who meta">{d.role}, {d.org}</p>
    <p class="summary">{d.summary}</p>
    {
      d.tags.length > 0 && (
        <ul class="topics meta" aria-label="Topics">
          {d.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0 2rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  .row:first-of-type {
    border-top: 0;
  }
  .when {
    margin: 0.3rem 0 0;
  }
  h3 {
    margin: 0;
    font-size: clamp(1.45rem, 2.4vw, 1.75rem);
    font-weight: 600;
  }
  h3 a {
    color: var(--maroon);
    text-decoration: none;
  }
  h3 a:hover,
  h3 a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--amber);
  }
  .who {
    margin: 0.3rem 0 0.55rem;
  }
  .summary {
    margin: 0 0 0.55rem;
    max-width: var(--measure);
  }
  .topics {
    font-size: 0.98rem;
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
    }
    .when {
      margin: 0 0 0.25rem;
    }
  }
</style>
