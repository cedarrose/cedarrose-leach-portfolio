---
import { formatYears, workUrl, type Work } from '../lib/work';

interface Props {
  work: Work;
}
const { work } = Astro.props;
const d = work.data;
// The org without a trailing ", USC" keeps rows to one line. It's left out
// when it would just repeat the title (e.g. "Memoir" at "Memoir Photos").
const org = d.org.replace(/, USC$/, '');
const t = d.title.toLowerCase();
const o = org.toLowerCase();
const showOrg = !(t.startsWith(o) || o.startsWith(t));
---

<li>
  <a class="row" href={workUrl(work)}>
    <span class="years meta"><time datetime={d.start}>{formatYears(d.start, d.end)}</time></span>
    <span class="title">{d.title}</span>
    {showOrg && <span class="org meta">{org}</span>}
  </a>
</li>

<style>
  li {
    border-top: 1px solid var(--rule);
  }
  li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 1.5rem;
    padding: 1.05rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .title {
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .org {
    text-align: right;
    white-space: nowrap;
  }
  .row:hover .title,
  .row:focus-visible .title {
    color: var(--maroon);
  }
  .row:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  @media (max-width: 44rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      padding: 1rem 0;
    }
    .title {
      font-size: 1.15rem;
    }
    .org {
      text-align: left;
      white-space: normal;
    }
  }
</style>
